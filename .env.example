# .env.example — copy to .env for local development, never commit .env
#
# ─── HARNESS-INJECTED (eval time only) ───────────────────────────────────────
# These three are injected by the grading harness at evaluation time.
# For local dev: fill them in below and run:  export $(grep -v '^#' .env | xargs)
# They must NEVER be hardcoded in source files or baked into the Docker image.
#
export FIREWORKS_API_KEY='fw_your_api_key_here'
export FIREWORKS_BASE_URL='https://api.fireworks.ai/inference/v1'
export ALLOWED_MODELS='accounts/fireworks/models/minimax-m3,accounts/fireworks/models/kimi-k2p7-code,accounts/fireworks/models/gemma-4-31b-it,accounts/fireworks/models/gemma-4-26b-a4b-it,accounts/fireworks/models/gemma-4-31b-it-nvfp4'
# ─── ENVIRONMENT PROFILE ─────────────────────────────────────────────────────
# Controls thread counts, n_ctx, GPU offload.  Leave unset for local dev
# (auto-detected as "local").  Set to "docker" or "amd_notebook" to simulate
# those environments locally.
#
# EVAL_ENV=local        ← default when unset: 8 Fireworks threads, n_ctx=4096
# EVAL_ENV=docker       ← baked into Dockerfile: 4 threads, n_ctx=2048, no GPU
# EVAL_ENV=amd_notebook ← AMD hackathon notebook: 4 threads, n_ctx=2048, no GPU

# ─── LOCAL MODEL PATHS ───────────────────────────────────────────────────────
# Override these when testing locally (models/ lives next to main.py, not /app/).
# The Dockerfile bakes in the /app/models/ paths as defaults.
#
# Qwen2.5-1.5B is primary (better structured JSON / NER output).
# SmolLM2-1.7B is fallback.
LOCAL_MODEL_PATH=models/qwen2.5-1.5b-instruct-q4_k_m.gguf
LOCAL_MODEL_FALLBACK_PATH=models/smollm2-1.7b-instruct-q4_k_m.gguf

# ─── GPU OFFLOAD (local dev only) ────────────────────────────────────────────
# Set to 1 to offload ~20 layers to your Nvidia T1200 (4 GB VRAM).
# Has no effect inside the Docker image (GPU layers = 0 always in docker profile).
#
LOCAL_USE_GPU=0

# ─── OPTIONAL OVERRIDES ──────────────────────────────────────────────────────
# EVAL_CLUSTER is kept for backward compat but no longer used — EVAL_ENV
# is the canonical way to select a profile.
# EVAL_CLUSTER=0
